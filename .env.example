# ──────────────────────────────────────────────────────────────────────────
# MapleHaus environment configuration
# Copy this file to `.env.local` and fill in values. All AI features degrade
# gracefully to a transparent heuristic engine when no API key is present,
# so the platform runs end-to-end with zero configuration.
# ──────────────────────────────────────────────────────────────────────────

# Anthropic API key — powers the "Aria" AI copilot and AI valuation rationale.
# Without it, Aria falls back to a built-in rules engine over the listing data.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model used by the Aria copilot. Defaults to claude-opus-4-8 (most capable).
# For higher-volume / lower-cost production chat you may set:
#   ARIA_MODEL=claude-sonnet-4-6   (balanced)
#   ARIA_MODEL=claude-haiku-4-5    (fastest / cheapest)
ARIA_MODEL=claude-opus-4-8

# Unsplash Access Key — when set, /api/photo serves live, query-matched
# listing photography from the Unsplash API (pools cached to respect rate
# limits). Without it, listings use a curated set of real Unsplash photos.
# Get a free key at https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=
